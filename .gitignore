# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment
.env
.env.*

# macOS
.DS_Store

# Data files (large — use DVC or share separately)
data/*.parquet
data/*.csv
data/*.db

# Models (large — store in cloud or DVC)
models/*.pkl
models/*.joblib
models/*.json
# tuned hyperparameters are small and costly to regenerate: keep them in git
!models/best_params.json

# Outputs (regenerate from notebooks)
outputs/*
!outputs/.gitkeep

# R leftovers
.Rproj.user
.Rhistory
.RData
.Ruserdata

# FBref raw HTML cache + browser profile (notebook 05)
data/_fbref/

# Snapshot of the La Liga-only (v1) data and models, taken before the V2 scrape
data/_v1_backup/

# MLflow tracking store and artifacts (src/models/registry.py)
mlops/

# Understat raw responses, cached per league-season (notebook 02)
data/_understat/

# Crosswalk outputs regenerated by notebooks 02 / 05. id_overrides.csv stays
# in git: it holds the decisions a person made on the review files.
data/manual/review_*.csv
data/manual/club_crosswalk.csv

# Proposed overrides, written for a person to accept (see id_overrides.csv)
data/manual/proposed_*.csv
